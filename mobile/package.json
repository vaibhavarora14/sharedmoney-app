{
  "name": "mobile",
  "version": "2.31.4",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "android:release:local": "expo run:android --variant release",
    "update": "eas update --branch development",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --branch production",
    "test:e2e": "maestro test .maestro/",
    "ios": "expo run:ios",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "version:build": "node scripts/version.js build",
    "version:show": "node scripts/version.js show",
    "test:android-push-config": "node --test config/androidPushConfig.test.cjs",
    "test:sentry-build-config": "node --test config/sentryBuildConfig.test.cjs",
    "test:expo-public-config": "node --test config/expoPublicConfig.test.cjs",
    "test:ios-scene-lifecycle": "node --test plugins/withIosSceneLifecycle.test.cjs",
    "test:icon-imports": "node scripts/verify-icon-imports.mjs",
    "verify:android-push-config": "node scripts/verify-android-push-config.cjs",
    "verify:sentry-build": "node scripts/verify-sentry-build.cjs",
    "eas-build-pre-install": "npm run verify:android-push-config && npm run verify:sentry-build && npm run test:expo-public-config && npm run test:ios-scene-lifecycle && npm run test:icon-imports",
    "verify:canonical-links": "node scripts/verify-canonical-links.mjs",
    "android:release": "eas submit --platform android --profile internal",
    "deploy:web": "npx expo export -p web && eas deploy --prod --non-interactive",
    "export:web:expo-redirect": "node scripts/export-expo-redirect.mjs",
    "deploy:web:expo-redirect": "npm run export:web:expo-redirect && eas deploy --prod --non-interactive --export-dir dist",
    "export:web:sharedmoney": "EXPO_NO_TELEMETRY=1 EXPO_PUBLIC_APP_URL=https://sharedmoney.app/app EXPO_PUBLIC_WEB_BASE_URL=/app npx expo export -p web --output-dir ../web/dist/app --max-workers 1"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.90.12",
    "date-fns": "^4.1.0",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-insights": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "posthog-react-native": "^4.68.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.0.0",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-paper": "5.14.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.4",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~6.0.3"
  }
}
