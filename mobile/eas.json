{
  "cli": {
    "version": ">= 5.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EAS_BUILD": "true",
        "EXPO_PUBLIC_USE_DEV_CLIENT": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EAS_BUILD": "true",
        "EXPO_PUBLIC_USE_DEV_CLIENT": "true"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "ios": {
        "image": "sdk-57"
      },
      "android": {
        "image": "sdk-57"
      },
      "env": {
        "EAS_BUILD": "true",
        "EXPO_PUBLIC_APP_URL": "https://sharedmoney.app/app",
        "REQUIRE_ANDROID_PUSH_CONFIG": "true",
        "SENTRY_ORG": "jobappagent",
        "SENTRY_PROJECT": "react-native"
      }
    },
    "verification": {
      "extends": "production",
      "distribution": "internal",
      "channel": "verification",
      "env": {
        "EXPO_PUBLIC_ENABLE_SENTRY_DIAGNOSTICS": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6755923591"
      }
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6755923591"
      }
    },
    "store": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6755923591"
      }
    }
  }
}
