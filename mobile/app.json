{
  "_comment": "This file is superseded by app.config.js. The dynamic config in app.config.js takes precedence and supports both Expo Go and Development Builds.",
  "expo": {
    "name": "SharedMoney",
    "slug": "share-money",
    "scheme": [
      "sharedmoney",
      "owewho"
    ],
    "version": "2.31.4",
    "_comment_version": "This is superseded by app.config.js which reads from version.json",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaibhavarora.sharemoney",
      "scheme": [
        "sharedmoney",
        "owewho"
      ],
      "buildNumber": "115",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vaibhavarora.sharemoney",
      "scheme": [
        "sharedmoney",
        "owewho"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F9FC"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-font",
      "expo-web-browser"
    ]
  }
}
