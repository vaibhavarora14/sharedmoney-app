# Supabase Configuration
# Get these values from: Supabase Dashboard > Settings > API
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key

# Google OAuth for local Supabase Auth.
# In Google Cloud, create a Web OAuth client and add:
# http://127.0.0.1:54321/auth/v1/callback
# as an Authorized redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your_google_web_client_secret

# WhatsApp OTP login (edge). Leave ENABLE unset in production.
# ENABLE_WHATSAPP_OTP_LOGIN=true
# WHATSAPP_OTP_PEPPER=long-random-server-pepper
# WHATSAPP_OTP_DELIVERY=text
# WHATSAPP_TOKEN=meta_access_token
# WHATSAPP_PHONE_NUMBER_ID=meta_test_phone_number_id
# WHATSAPP_OTP_TEMPLATE_NAME=sharedmoney_otp
# WHATSAPP_OTP_TEMPLATE_LANG=en
# Optional spend / abuse controls (defaults are safe for India go-live):
# WHATSAPP_MONTHLY_BUDGET_INR=500
# WHATSAPP_OTP_COST_INR=0.14
# WHATSAPP_OTP_ALLOWED_COUNTRY_CODES=91
